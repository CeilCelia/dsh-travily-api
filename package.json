{
  "name": "dsh-travily-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tavily web search for DeepSeek Harness: a settings switch back to the platform search provider, the API key held as a credential, and a connection test.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CeilCelia/dsh-travily-api.git"
  },
  "bugs": {
    "url": "https://github.com/CeilCelia/dsh-travily-api/issues"
  },
  "homepage": "https://github.com/CeilCelia/dsh-travily-api#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "web-search",
    "tavily"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-credentials-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "js-yaml": "^4.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "test": "node .tools/selftest.mjs && node .tools/integration.mjs && node .tools/client-harness.mjs",
    "test:e2e": "node .tools/verify-install.mjs",
    "test:live": "node .tools/live-search.mjs"
  }
}
